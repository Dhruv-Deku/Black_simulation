#version 460 core

// Deposits the gas into the grid the ray tracer draws: with light delay on, the copy
// of each parcel that the camera sees (where it was when the light now arriving left
// it; see particles_update.comp), otherwise the parcel itself.

layout(local_size_x = 256) in;

#include "particle_common.glsl"

layout(std430, binding = 2) buffer Grid {
    int cells[];
};

uniform int uCount;
uniform float uSpin;
uniform int uSeen;  // deposit the light-delayed copies
uniform ivec3 uGridDims;
uniform vec2 uGridLogR;

// Fixed-point scales (see grid_resolve.comp).
const float kWeightScale = 256.0;
const vec4 kVelocityScale = vec4(256.0, 4096.0, 65536.0, 65536.0);
const float kTemperatureScale = 256.0 / 100.0;

void deposit(int x, int y, int z, float w, vec4 u, float temperature) {
    if (x < 0 || x >= uGridDims.x || y < 0 || y >= uGridDims.y || w <= 0.0) return;
    z = (z % uGridDims.z + uGridDims.z) % uGridDims.z;
    int base = 6 * ((z * uGridDims.y + y) * uGridDims.x + x);
    atomicAdd(cells[base + 0], int(round(w * kWeightScale)));
    atomicAdd(cells[base + 1], int(round(w * u.x * kVelocityScale.x)));
    atomicAdd(cells[base + 2], int(round(w * u.y * kVelocityScale.y)));
    atomicAdd(cells[base + 3], int(round(w * u.z * kVelocityScale.z)));
    atomicAdd(cells[base + 4], int(round(w * u.w * kVelocityScale.w)));
    atomicAdd(cells[base + 5], int(round(w * temperature * kTemperatureScale)));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(uCount)) return;
    Particle p = particles[index];
    float a = uSpin;
    float E = p.constants.x, L = p.constants.y, Q = p.constants.z;
    float r, th, ph, vr, vth;
    if (uSeen == 1) {
        // Seen only once its light has started arriving, and until its last light has.
        if (p.state.w <= 0.0 || p.seen.w <= p.seenVelocity.z || p.seen.w >= p.seenVelocity.w) return;
        r = p.seen.x;
        th = p.seen.y;
        ph = p.seen.z;
        // The copy follows today's constants of motion (the gas may have nudged them
        // since): put its velocities back on vr^2 = R, vtheta^2 = Theta.
        float delta = r * r - 2.0 * r + a * a;
        float P = E * (r * r + a * a) - a * L;
        float x = L - a * E;
        float R = P * P - delta * (r * r + x * x + Q);
        float s = max(abs(sin(th)), 1e-4), c = cos(th);
        float Theta = Q - c * c * (a * a * (1.0 - E * E) + L * L / (s * s));
        vr = (p.seenVelocity.x < 0.0 ? -1.0 : 1.0) * sqrt(max(R, 0.0));
        vth = (p.seenVelocity.y < 0.0 ? -1.0 : 1.0) * sqrt(max(Theta, 0.0));
    } else {
        if (p.state.w < 1.0) return;
        r = p.state.x;
        th = p.state.y;
        ph = p.state.z;
        vr = p.velocity.x;
        vth = p.velocity.y;
    }

    float tDot, phiDot, accR, accTh;
    massiveRhs(a, E, L, Q, r, th, vr, tDot, phiDot, accR, accTh);
    float sigma = r * r + a * a * cos(th) * cos(th);
    vec4 u = vec4(clamp(tDot / sigma, 0.0, 50.0), vr / sigma, vth / sigma, phiDot / sigma);

    vec3 g = vec3((log(r) - uGridLogR.x) / (uGridLogR.y - uGridLogR.x) * float(uGridDims.x),
                  th / PI * float(uGridDims.y),
                  ph / (2.0 * PI) * float(uGridDims.z)) - 0.5;
    if (g.x < -1.0 || g.x > float(uGridDims.x)) return;
    ivec3 b = ivec3(floor(g));
    vec3 f = g - vec3(b);
    for (int corner = 0; corner < 8; ++corner) {
        ivec3 o = ivec3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1);
        vec3 wt = mix(1.0 - f, f, vec3(o));
        deposit(b.x + o.x, b.y + o.y, b.z + o.z, p.velocity.w * wt.x * wt.y * wt.z, u, p.velocity.z);
    }
}
